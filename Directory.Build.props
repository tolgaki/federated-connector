<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Preview packages (MCP SDK) and NuGet audit advisories should not break local builds. -->
    <WarningsNotAsErrors>NU1603;NU1608;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>Federated Connector Blueprint</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
