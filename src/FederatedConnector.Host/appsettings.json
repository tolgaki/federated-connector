{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Connector": {
    "DisplayName": "Contoso Knowledge",
    "Provider": "FoundryIq",
    "AllowedTenants": [],
    "AcceptedAudiences": [],
    "RequiredScope": "access_as_user",
    "HandleSigningKey": "",
    "HandleLifetimeMinutes": 60,
    "ManagedIdentityClientId": "",
    "Limits": {
      "ToolTimeoutSeconds": 8,
      "MaxFetchChars": 20000,
      "MaxSnippetChars": 500,
      "MaxQueryChars": 1000,
      "RequestsPerMinutePerUser": 60
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientCredentials": [
      {
        "SourceType": "SignedAssertionFromManagedIdentity",
        "ManagedIdentityClientId": ""
      }
    ]
  },
  "Providers": {
    "FoundryIq": {
      "Endpoint": "",
      "ContentDescription": "documents from Foundry IQ knowledge bases",
      "ApiVersion": "2026-04-01",
      "PreviewApiVersion": "2026-08-01-preview",
      "UsePreviewApi": false,
      "OutputMode": "extractiveData",
      "KnowledgeBases": [],
      "ExcludedKnowledgeSourceKinds": [ "workIQ" ],
      "VerifyCitationUrlTrimming": true,
      "MetadataCacheMinutes": 10
    }
  }
}
